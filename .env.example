# --------------------------------------------------------------------------
# kiro-router — example configuration
# Copy to .env or export these in your shell before `npm start`.
# Everything is optional. The defaults below match what you'd get with no
# .env at all.
# --------------------------------------------------------------------------

# HTTP server port (default: 11437).
PORT=11437

# Bind address (default: 0.0.0.0 — accept connections from anything that can
# reach this machine). Set to 127.0.0.1 to limit access to the local machine.
#
# IMPORTANT: when bound to 0.0.0.0 (or any non-loopback address), you should
# set a password so the proxy isn't open to your LAN / VPN / the internet.
HOST=0.0.0.0

# Password / API key required from clients (Authorization: Bearer <value>).
# Easier alternative: run `npm run set-password` to store it persistently in
# ~/.kiro-router/password instead of this env var. The env var (if set) wins.
# Generate a strong one with:   openssl rand -hex 32
# API_KEY=
# PASSWORD=                      # alias of API_KEY; both work

# Path to the Kiro/AWS SSO token cache directory.
# Default: ~/.aws/sso/cache (where Kiro IDE writes kiro-auth-token.json)
# KIRO_TOKEN_DIR=

# Optional: explicit refresh token (overrides auto-discovery).
# Useful when running headless (Docker, CI) — paste the refreshToken from
# ~/.aws/sso/cache/kiro-auth-token.json on a machine where you logged into
# Kiro IDE. Token starts with `aorAAAAAG`.
# KIRO_REFRESH_TOKEN=

# Profile ARN — only needed for AWS IDC (enterprise) users. Leave empty for
# AWS Builder ID (the default Kiro login).
# KIRO_PROFILE_ARN=

# Refresh access tokens this many seconds BEFORE they expire (default: 300).
# Larger value = less risk of expired-token races. AWS issues tokens with
# expiresIn ~3600s.
KIRO_REFRESH_LEAD_SECONDS=300

# Routing strategy across multiple Kiro accounts:
#   round-robin (default) | least-used | priority
KIRO_STRATEGY=round-robin

# Logging level: error | warn | info | debug (default: info)
LOG_LEVEL=info
