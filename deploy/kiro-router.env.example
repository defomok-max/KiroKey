# Copy to /etc/kiro-router.env for systemd or to .env for docker compose.
# Always set a strong API key before binding to 0.0.0.0.
API_KEY=change-me-long-random-password
HOST=0.0.0.0
PORT=11437
LOG_LEVEL=info
KIRO_STRATEGY=round-robin
KIRO_REFRESH_LEAD_SECONDS=300
KIRO_SERVER_MODE=1
# KIRO_SERVER_MODE=1 makes API_KEY mandatory and changes default KIRO_TOKEN_DIR
# to a server/container-safe path.

# Option A: server has copied Kiro SSO JSON files.
# KIRO_TOKEN_DIR=/var/lib/kiro-router/aws-sso-cache

# Option B: headless server with one refresh token.
# KIRO_REFRESH_TOKEN=aorAAAAAG...
# KIRO_PROFILE_ARN=
